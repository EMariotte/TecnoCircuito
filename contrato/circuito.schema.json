{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EMariotte/TecnoCircuito/blob/main/contrato/circuito.schema.json",
  "title": "Circuito de TecnoCircuito, formato 1 (contrato 1)",
  "description": "Va en el campo «circuito» del proyecto .tbq.json de TecnoBloques. Es la fuente de los nombres de pines de cada pieza, de los colores de cable y de los huecos de la protoboard. Ver CONTRATO.md, sección 4. Es tolerante con lo nuevo: un tipo de pieza o un campo que no conoce no lo invalida (contrato, secciones 4 y 8). Lo que un esquema no puede revisar (que cada cable llegue a una pieza que existe y a un pin que esa pieza tiene) lo revisa prototipo/pruebas/contrato.js.",
  "type": "object",
  "required": ["formato", "placa", "componentes", "cables"],
  "properties": {
    "formato": { "const": 1, "description": "Versión del formato del circuito. Si cambia, el paquete abre los formatos viejos y los convierte." },
    "placa": { "enum": ["uno", "nano", "nano_old", "mega"], "description": "Las mismas claves de PLACAS en TecnoBloques. La placa está fija en el origen (0, 0)." },
    "componentes": { "type": "array", "items": { "$ref": "#/$defs/componente" } },
    "cables": { "type": "array", "items": { "$ref": "#/$defs/cable" } },
    "protoboard": {
      "description": "Como máximo una. null si no hay.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/protoboard" }]
    }
  },
  "allOf": [{"if": {"properties": {"placa": {"enum": ["uno", "mega"]}}}, "then": {"properties": {"componentes": {"items": {"not": {"properties": {"tipo": {"const": "shield_nano_io"}}, "required": ["tipo"]}}}}}}, {"if": {"properties": {"placa": {"enum": ["nano", "nano_old"]}}}, "then": {"properties": {"componentes": {"allOf": [{"items": {"not": {"properties": {"tipo": {"const": "shield_l293d"}}, "required": ["tipo"]}}}, {"contains": {"properties": {"tipo": {"const": "shield_nano_io"}}, "required": ["tipo"]}, "minContains": 0, "maxContains": 1}]}}}}],
  "$defs": {
    "numero": { "type": "number" },
    "punto": {
      "description": "[x, y] en px del dibujo a escala 1 (0,1 pulgadas = 9,6 px); la y crece hacia abajo.",
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "id": {
      "description": "Identificador de la pieza: sin puntos ni espacios. «placa» y «protoboard» están reservados.",
      "type": "string",
      "pattern": "^[^.\\s]+$",
      "not": { "enum": ["placa", "protoboard"] }
    },
    "referencia": {
      "description": "Un pin: «<id>.<pin>». La placa siempre se llama «placa» y la protoboard «protoboard».",
      "type": "string",
      "pattern": "^[^.\\s]+\\.[^.\\s]+$"
    },
    "color-cable": {
      "description": "En el orden del código de colores (0 a 9). «morado» se muestra como violeta.",
      "enum": ["negro", "marron", "rojo", "naranja", "amarillo", "verde", "azul", "morado", "gris", "blanco"]
    },

    "pines-placa-uno": {
      "description": "Cada pin físico tiene nombre propio. GND1, GND2 y GND3 son el mismo nodo, igual que SDA con A4 y SCL con A5.",
      "enum": [
        "D0", "D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9", "D10", "D11", "D12", "D13",
        "A0", "A1", "A2", "A3", "A4", "A5",
        "GND1", "GND2", "GND3", "5V", "3V3", "VIN", "AREF", "IOREF", "RESET", "SDA", "SCL"
      ]
    },
    "pines-placa-nano": {"description": "Nano clásico: A6/A7 solo analógicos; dos GND y dos RESET; aliases de I2C/SPI son los mismos nodos GPIO.", "enum": ["D0", "D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9", "D10", "D11", "D12", "D13", "A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7", "GND1", "GND2", "5V", "3V3", "VIN", "AREF", "RESET", "RESET2", "SDA", "SCL", "MISO", "MOSI", "SCK", "SS"]},
    "pines-shield_nano_io": {"description": "82 contactos físicos: I2C junto a UART; bloque de seis contactos con tres 3V3 y tres GND (medido por TecnoDiseñador, 13 oct). SPI_* y OUT_5V/OUT_5V_2 son aliases heredados de los pines del Nano (OUT_5V va al 5V), no contactos de la expansión. JACK_POS y OUT_3V3 permanecen separados de VIN y 3V3 del módulo.", "enum": ["D0_S", "D0_V", "D0_G", "D1_S", "D1_V", "D1_G", "D2_S", "D2_V", "D2_G", "D3_S", "D3_V", "D3_G", "D4_S", "D4_V", "D4_G", "D5_S", "D5_V", "D5_G", "D6_S", "D6_V", "D6_G", "D7_S", "D7_V", "D7_G", "D8_S", "D8_V", "D8_G", "D9_S", "D9_V", "D9_G", "D10_S", "D10_V", "D10_G", "D11_S", "D11_V", "D11_G", "D12_S", "D12_V", "D12_G", "D13_S", "D13_V", "D13_G", "A0_S", "A0_V", "A0_G", "A1_S", "A1_V", "A1_G", "A2_S", "A2_V", "A2_G", "A3_S", "A3_V", "A3_G", "A4_S", "A4_V", "A4_G", "A5_S", "A5_V", "A5_G", "A6_S", "A6_V", "A6_G", "A7_S", "A7_V", "A7_G", "I2C_SDA", "I2C_SCL", "I2C_V", "I2C_G", "SPI_MISO", "SPI_MOSI", "SPI_SCK", "SPI_SS", "SPI_V", "SPI_G", "UART_TX", "UART_RX", "UART_V", "UART_G", "OUT_5V", "OUT_3V3", "GND_OUT", "JACK_POS", "JACK_GND", "OUT_5V_2", "OUT_3V3_2", "GND_OUT_2", "OUT_3V3_3", "GND_OUT_3"]},
    "pines-resistencia": { "enum": ["1", "2"] },
    "pines-led": { "enum": ["anodo", "catodo"] },
    "pines-potenciometro": { "description": "SIG es el cursor (la pata del medio).", "enum": ["GND", "SIG", "VCC"] },
    "pines-pulsador": { "description": "Las patas con el mismo número están unidas por dentro; al presionar se une la 1 con la 2.", "enum": ["1i", "1d", "2i", "2d"] },
    "pines-servo": { "description": "Los 3 cables del microservo: GND (marrón), VCC (rojo) y SIG, la señal (naranja).", "enum": ["GND", "VCC", "SIG"] },
    "pines-shield_l293d": {
      "description": "Shield de motores L293D Rev4, montada sobre el Uno. Bornes de los motores (M1A … M4B), sus GND, la entrada de la batería (EXT_POS, EXT_GND) y los conectores de servo (S1 va al pin 10 y S2 al 9).",
      "enum": ["M1A", "M1B", "GND_IZQ", "M2A", "M2B", "M4A", "M4B", "GND_DER", "M3A", "M3B", "EXT_POS", "EXT_GND", "S2_SIG", "S2_POS", "S2_GND", "S1_SIG", "S1_POS", "S1_GND"]
    },
    "pines-motor_tt": { "description": "Los 2 cables del motorreductor TT: A (rojo) y B (negro).", "enum": ["A", "B"] },
    "pines-bateria_lipo": { "description": "El cable de potencia de la LiPo 2S: POS (rojo, +) y NEG (negro, −). El de balance: BAL0 (el −), BAL1 (entre las dos celdas) y BAL2 (el +).", "enum": ["POS", "NEG", "BAL0", "BAL1", "BAL2"] },
    "pines-probador_lipo": { "description": "Probador de celdas 1-8S: NEG (el − del balance) y C1 a C8 (el + de cada celda).", "enum": ["NEG", "C1", "C2", "C3", "C4", "C5", "C6", "C7", "C8"] },
    "hueco-media": {
      "description": "Huecos de la media protoboard de 400 puntos, como vienen impresos. Tiras: a1 … j30. Rieles: s+N, s-N (superiores), i+N, i-N (inferiores), sin las columnas 1, 7, 13, 19 y 25.",
      "type": "string",
      "pattern": "^([a-j]([1-9]|[12][0-9]|30)|[si][+-]([2-6]|[89]|1[0-2]|1[4-8]|2[0-4]|2[6-9]|30))$"
    },

    "protoboard": {
      "type": "object",
      "required": ["tipo", "x", "y"],
      "properties": {
        "tipo": { "enum": ["media"] },
        "x": { "$ref": "#/$defs/numero" },
        "y": { "$ref": "#/$defs/numero" }
      }
    },
    "cable": {
      "type": "object",
      "required": ["de", "a"],
      "properties": {
        "de": { "$ref": "#/$defs/referencia" },
        "a": { "$ref": "#/$defs/referencia" },
        "color": { "$ref": "#/$defs/color-cable" },
        "puntos": { "description": "Dobleces, en orden desde «de» hasta «a».", "type": "array", "items": { "$ref": "#/$defs/punto" } }
      }
    },
    "en": {
      "description": "Dónde va cada pata: en un hueco de la protoboard ({ \"<pata>\": \"protoboard.<hueco>\" }, solo si hay protoboard) o enchufada directo en el pin de otra pieza o de la placa ({ \"<pata>\": \"<id>.<pin>\" }, como el probador en el balance de la batería). Es lo que manda para la conexión.",
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[^.\\s]+\\.[^.\\s]+$" }
    },
    "componente": {
      "type": "object",
      "required": ["id", "tipo", "x", "y"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tipo": { "type": "string", "description": "Un tipo que esta versión no conoce es válido: se muestra como «desconocido» y no se simula." },
        "x": { "$ref": "#/$defs/numero" },
        "y": { "$ref": "#/$defs/numero" },
        "rot": { "enum": [0, 90, 180, 270], "description": "Gira el dibujo alrededor de su centro, en el sentido del reloj." },
        "props": { "type": "object" },
        "en": { "$ref": "#/$defs/en" }
      },
      "allOf": [
        {
          "if": { "properties": { "tipo": { "const": "resistencia" } } },
          "then": {
            "properties": {
              "props": { "properties": { "ohmios": { "type": "number", "exclusiveMinimum": 0 } } },
              "en": { "propertyNames": { "$ref": "#/$defs/pines-resistencia" } }
            }
          }
        },
        {
          "if": { "properties": { "tipo": { "const": "led" } } },
          "then": {
            "properties": {
              "props": { "properties": { "color": { "enum": ["rojo", "verde", "amarillo", "azul", "blanco"] } } },
              "en": { "propertyNames": { "$ref": "#/$defs/pines-led" } }
            }
          }
        },
        {
          "if": { "properties": { "tipo": { "const": "potenciometro" } } },
          "then": {
            "properties": {
              "props": {
                "properties": {
                  "ohmios": { "type": "number", "exclusiveMinimum": 0 },
                  "posicion": { "type": "number", "minimum": 0, "maximum": 1, "description": "0 = perilla hacia GND, 1 = hacia VCC." }
                }
              },
              "en": { "propertyNames": { "$ref": "#/$defs/pines-potenciometro" } }
            }
          }
        },
        {
          "if": { "properties": { "tipo": { "const": "servo" } } },
          "then": {
            "properties": {
              "props": { "properties": { "modelo": { "enum": ["sg90", "mg90s"], "description": "Cambia el dibujo, el consumo y la velocidad." } } },
              "en": { "propertyNames": { "$ref": "#/$defs/pines-servo" } }
            }
          }
        },
        {
          "if": { "properties": { "tipo": { "const": "shield_l293d" } } },
          "then": {
            "properties": {
              "x": { "const": 0 },
              "y": { "const": 0 },
              "props": { "properties": { "puentePWR": { "type": "boolean", "description": "Puesto (true): la batería de EXT_PWR también alimenta el VIN del Uno." } } },
              "en": false
            }
          }
        },
        {
          "if": { "properties": { "tipo": { "const": "motor_tt" } } },
          "then": {
            "properties": {
              "props": {
                "properties": {
                  "vista": { "enum": ["eje", "rueda"], "description": "Solo el eje con sus RPM, o con la rueda y hacia dónde avanzaría." },
                  "lado": { "enum": ["izquierdo", "derecho"], "description": "Lado del robot: refleja el dibujo y el sentido de avance." }
                }
              },
              "en": { "propertyNames": { "$ref": "#/$defs/pines-motor_tt" } }
            }
          }
        },
        {
          "if": { "properties": { "tipo": { "const": "bateria_lipo" } } },
          "then": {
            "properties": {
              "props": { "properties": { "carga": { "enum": ["llena", "nominal", "descargada", "desbalanceada"], "description": "8,4 V (4,2 + 4,2), 7,4 V (3,7 + 3,7), 6,4 V (3,2 + 3,2) o desbalanceada: 7,4 V (3,95 + 3,45)." } } },
              "en": { "propertyNames": { "$ref": "#/$defs/pines-bateria_lipo" } }
            }
          }
        },
        {
          "if": { "properties": { "tipo": { "const": "probador_lipo" } } },
          "then": {
            "properties": {
              "props": { "properties": { "umbral": { "enum": [0, 2.7, 2.8, 2.9, 3, 3.1, 3.2, 3.3, 3.4, 3.5, 3.6, 3.7, 3.8], "description": "Pita si una celda baja de este voltaje. 0 = alarma apagada." } } },
              "en": { "propertyNames": { "$ref": "#/$defs/pines-probador_lipo" } }
            }
          }
        },
        {
          "if": { "properties": { "tipo": { "const": "pulsador" } } },
          "then": {
            "properties": {
              "props": { "properties": { "color": { "enum": ["rojo", "verde", "azul", "amarillo", "blanco", "negro"] } } },
              "en": { "propertyNames": { "$ref": "#/$defs/pines-pulsador" } }
            }
          }
        },
        {"if": {"properties": {"tipo": {"const": "shield_nano_io"}}}, "then": {"properties": {"x": {"const": 0}, "y": {"const": 0}, "rot": {"const": 0}, "en": false, "props": {"properties": {"variante": {"enum": ["roja", "azul"]}, "alimentacion": {"enum": ["usb", "jack", "apagada"]}, "voltajeJack": {"enum": [0, 5, 7, 9, 12]}}}}}}
      ]
    }
  }
}
